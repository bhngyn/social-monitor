# =============================================================================
# Social Monitor - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# --- Apify API ---
# Get your API token from https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# --- Storage ---
# Path on the HOST machine where archived media will be stored.
# This should point to your dedicated storage drive.
# Examples:
#   macOS:   /Volumes/ArchiveDrive/social_monitor
#   Linux:   /mnt/archive/social_monitor
#   Windows: /c/Archive/social_monitor
ARCHIVE_HOST_PATH=./archive_data

# --- PostgreSQL ---
POSTGRES_USER=social_monitor
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=social_monitor
DATABASE_URL=postgresql+asyncpg://social_monitor:change_me_in_production@db:5432/social_monitor

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Docker Resource Limits (adjust for your machine) ---
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=4G
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1G

# --- Ingestion Settings ---
# Maximum concurrent ingestion runs
MAX_CONCURRENT_INGESTIONS=3
# Default poll interval in seconds (1 hour)
DEFAULT_POLL_INTERVAL=3600

# --- Media Download Defaults ---
# Maximum video file size in bytes (500MB)
MAX_VIDEO_FILESIZE=524288000
# Maximum video duration in seconds (0 = no limit)
MAX_VIDEO_DURATION=0
# Video resolution cap (e.g., "720", "1080", "best")
MAX_VIDEO_RESOLUTION=best
